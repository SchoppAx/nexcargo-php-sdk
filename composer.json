{
  "name": "schoppax/nexcargo-php-sdk",
  "description": "PHP SDK for the NexCargo (Camel Cloud API) carrier integration",
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "schoppax",
      "email": "schoppax@example.com"
    }
  ],
  "homepage": "https://github.com/schoppax/nextcargo-php-sdk",
  "repository": {
    "type": "git",
    "url": "https://github.com/schoppax/nextcargo-php-sdk.git"
  },
  "require": {
    "php": "^8.2",
    "guzzlehttp/guzzle": "^8.2"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.5 || ^12.5 || ^13.3",
    "phpstan/phpstan": "^2.0",
    "squizlabs/php_codesniffer": "^4.0"
  },
  "autoload": {
    "psr-4": {
      "NexCargo\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "NexCargo\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "setup": "bash scripts/setup.sh",
    "lint:check": "phpcs --standard=phpcs.xml.dist",
    "lint:fix": "phpcbf --standard=phpcs.xml.dist",
    "quality:check": "phpstan analyse -c phpstan.neon.dist --memory-limit=1G",
    "test": "phpunit --configuration=phpunit.xml.dist",
    "test:coverage": "phpunit --configuration=phpunit.xml.dist --coverage-clover=coverage.xml --coverage-text",
    "test:coverage-html": "phpunit --configuration=phpunit.xml.dist --coverage-html ./coverage-report",
    "test:all" : [
      "@lint:check",
      "@quality:check",
      "@test"
    ]
  }
}
